# CropDoctor AI — Environment Variables
# Copy this to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# API Keys (not needed until Milestone 4+)
GROQ_API_KEY=your_groq_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Model paths
MODEL_DIR=./models
MODEL_NAME=efficientnet_b0

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/cropdoctor.db

# Upload limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp

# Inference thresholds
OOD_CONFIDENCE_THRESHOLD=0.4
OOD_ENTROPY_THRESHOLD=2.5
BLUR_THRESHOLD=100.0
BRIGHTNESS_LOW_THRESHOLD=40
BRIGHTNESS_HIGH_THRESHOLD=220
